{
  "manifest_version": 3,
  "name": "GIF Extensions",
  "version": "1.0.0",
  "description": "Notify you about your GIF GitHub issues instantly.",
  "permissions": ["alarms"],
  "host_permissions": [
    "https://gif-backend-jemy.onrender.com/*"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon-32.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
